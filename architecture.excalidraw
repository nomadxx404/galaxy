      "text": "POST /companies\nheader - jwt\nbody - name description logo_file_id\n201\n400 401 409 5xx\n\nPATCH /companies/{company_uuid}\nheader - jwt\nbody - name description logo_file_id\n200\n400 401 403 409 5xx\n\nGET /companies\nheader - jwt\nquery - name\n200 - list [company_uuid name logo_file_id]\n401 5xx\n\nGET /companies/{company_uuid}\nheader - jwt\n200 - company_uuid name description logo_file_id\n401 403 404 5xx\n\nDELETE /companies/{company_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPATCH /companies/{company_uuid}/members/{account_uuid}\nheader - jwt\nbody - role_id\n204\n401 403 404 5xx\n\nDELETE /companies/{company_uuid}/members/{account_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\nPOST /companies/{company_uuid}/members/{account_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /companies/{company_uuid}/invitations\nheader - jwt\nbody - email\n201\n400 401 403 5xx\n\nPOST /invitations/{token}/accept\nheader - jwt\n204\n400 401 409 410 5xx\n\n\n\nPOST /companies/{company_uuid}/roles\nheader - jwt\nbody - name description color\n201\n400 401 403 404 409 5xx\n\nGET /companies/{company_uuid}/roles\nheader - jwt\n200 - list [role_id name description color]\n401 403 404 5xx\n\nPATCH /companies/{company_uuid}/roles/{role_id}\nheader - jwt\nbody - name description color\n200\n400 401 403 404 409 5xx\n\nDELETE /companies/{company_uuid}/roles/{role_id}\nheader - jwt\n204\n401 403 404 409 5xx\n\n\n\nGET /permissions?scope=company\nheader - jwt\n200 - list [permissions description]\n401 5xx\n\nPUT /companies/{company_uuid}/members/{account_uuid}/permissions\nheader - jwt\nbody - list [permission]\n204\n400 401 403 404 409 5xx\n\n\n--------------------------------------------------\n\n\nGET /companies/{company_uuid}/members\nheader - jwt\n200 - list [account_uuid role_id role_name]\n401 403 404 5xx",
      "fontSize": 20,
      "fontFamily": 5,
