      "text": "POST /auth/login \nbody - email password \n200\n400 401 5xx\n\nPOST /auth/register\nbody - email password name nickname avatar_file_id\n201\n400 409 5xx\n\nPOST /auth/logout\nheader - jwt\n200\n401 5xx\n\nPOST /auth/full-logout\nheader - jwt\n200\n401 5xx\n\nPOST /auth/confirm-otp\nbody - email otp_code\n200\n400 404 410 5xx\n\nPOST /auth/reset-confirm-otp\nbody - email\n200\n400 5xx\n\nPOST /auth/forgot-password\nbody - email\n200\n400 404 5xx\n\nPOST /auth/reset-password\nbody - token new_password\n200\n400 410 5xx\n\nPOST /auth/refresh\n200\n401 5xx\n\n\n\nGET /profile\nheader - jwt\n200\n401 5xx\n\nPATCH/profile\nheader - jwt\nbody - name nickname avatar_file_id\n200\n401 5xx\n\n--- PATCH/profile/change-email\nheader - jwt\nbody - email\n204\n400 401 5xx\n\nPATCH/profile/change-password\nheader - jwt\nbody - old_password new_password\n204\n400 401 5xx\n\nDELETE /profile\nheader - jwt\n204\n401 5xx\n\n\n--------------------------------------------------------\n\n\nPOST /profiles/batch\nheader - jwt\nbody - list [account_uuid]\n200 - list [account_uuid name nickname avatar_file_id]\n400 401 403 5xx",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /auth/login \nbody - email password \n200\n400 401 5xx\n\nPOST /auth/register\nbody - email password name nickname avatar_file_id\n201\n400 409 5xx\n\nPOST /auth/logout\nheader - jwt\n200\n401 5xx\n\nPOST /auth/full-logout\nheader - jwt\n200\n401 5xx\n\nPOST /auth/confirm-otp\nbody - email otp_code\n200\n400 404 410 5xx\n\nPOST /auth/reset-confirm-otp\nbody - email\n200\n400 5xx\n\nPOST /auth/forgot-password\nbody - email\n200\n400 404 5xx\n\nPOST /auth/reset-password\nbody - token new_password\n200\n400 410 5xx\n\nPOST /auth/refresh\n200\n401 5xx\n\n\n\nGET /profile\nheader - jwt\n200\n401 5xx\n\nPATCH/profile\nheader - jwt\nbody - name nickname avatar_file_id\n200\n401 5xx\n\n--- PATCH/profile/change-email\nheader - jwt\nbody - email\n204\n400 401 5xx\n\nPATCH/profile/change-password\nheader - jwt\nbody - old_password new_password\n204\n400 401 5xx\n\nDELETE /profile\nheader - jwt\n204\n401 5xx\n\n\n--------------------------------------------------------\n\n\nPOST /profiles/batch\nheader - jwt\nbody - list [account_uuid]\n200 - list [account_uuid name nickname avatar_file_id]\n400 401 403 5xx",
      "autoResize": true,
      "lineHeight": 1.25
    },
