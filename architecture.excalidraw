      "text": "POST /projects/{project_uuid}/tasks\nheader - jwt\nbody - name description status_id priority_id planned_start due_date\n201\n400 401 403 5xx\n\nGET /projects/{project_uuid}/tasks\nheader - jwt\nquery - number status priority members created_at\n200 - list [task_uuid number name status priority assignments planned_start due_date completed_at created_by created_at]\n401 403 5xx\n\nGET /projects/{project_uuid}/tasks/{task_uuid}\nheader - jwt\n200 - task_uuid number name description status priority list[assignments] planned_start due_date completed_at created_by created_at\n401 403 5xx\n\nPATCH /projects/{project_uuid}/tasks/{task_uuid}\nheader - jwt\nbody - name description status_id priority_id planned_start due_date\n204\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/tasks/{task_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/tasks/{task_uuid}/review\nheader - jwt\nbody - action rejected_reason?\n204\n401 403 404 409 5xx\n\n\n\nPOST /projects/{project_uuid}/statuses\nheader - jwt\nbody - position name description color\n201\n400 401 403 409 5xx\n\nGET /projects/{project_uuid}/statuses\nheader - jwt\n200 - list [status_id position name description color]\n401 403 404 5xx\n\nPUT /projects/{project_uuid}/statuses/{status_id}\nheader - jwt\nbody - name description color\n204\n400 401 403 404 409 5xx\n\nPUT /projects/{project_uuid}/statuses/order\nheader - jwt\nbody - list [status_id]\n204\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/statuses/{status_id}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/tags\nheader - jwt\nbody - name description color\n201\n400 401 403 409 5xx\n\nGET /projects/{project_uuid}/tags\nheader - jwt\n200 - list [tag_id name description color]\n401 403 404 5xx\n\nPUT /projects/{project_uuid}/tags/{tag_id}\nheader - jwt\nbody - name description color\n204\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/tags/{tag_id}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/priorities\nheader - jwt\nbody - name description color\n201\n400 401 403 409 5xx\n\nGET /projects/{project_uuid}/priorities\nheader - jwt\n200 - list [priority_id name description color]\n401 403 404 5xx\n\nPUT /projects/{project_uuid}/priorities/{priority_id}\nheader - jwt\nbody - name description color\n204\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/priorities/{priority_id}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/tasks/{task_uuid}/assignments\nbody - account_uuid is_executer\n204\n400 401 403 404 409 5xx\n\nPATCH /projects/{project_uuid}/tasks/{task_uuid}/assignments\nbody - account_uuid is_executer\n204\n400 401 403 404 5xx\n\nDELETE /tasks/{task_uuid}/assignments/{account_uuid}\n204\n401 403 404 5xx\n\n\n\nGET /permissions?scope=task\nheader - jwt\n200 - list [permissions description]\n401 5xx\n\nPUT /projects/{project_uuid}/members/{account_uuid}/permissions/tasks\nheader - jwt\nbody - list [permission]\n204\n400 401 403 404 409 5xx\n\n\n---------------------------------------------\n\n\nGET /tasks/{task_uuid}/assignments\nheader - jwt\n200 - list [account_uuid]\n401 403 404 500xx\n\n\n",
