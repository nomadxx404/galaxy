      "originalText": "POST /companies/{company_uuid}/projects\nheader - jwt\nbody - name project_key description logo_file_id date_start date_end \n201 - project_uuid\n400 401 403 409 5xx\n\nGET /companies/{company_uuid}/projects\nheader - jwt\nquery - name is_active\n200 - list [project_uuid name logo_file_id]\n401 403 5xx\n\nGET /projects/{project_uuid}\nheader - jwt\n200 - name project_key description logo_file_id date_start date_end\n401 403 404 5xx\n\nPATCH /projects/{project_uuid}\nheader - jwt\nbody - name project_key  description logo_file_id date_start date_end\n200\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/members\nheader - jwt\nbody - account_uuid role_id\n201\n400 401 403 404 409 5xx\n\nPATCH /projects/{project_uuid}/members/{account_uuid}\nheader - jwt\nbody - role_id\n200\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/members/{account_uuid}\nheader - jwt\n204\n401 403 404 5xx\n\n\n\nPOST /projects/{project_uuid}/roles\nheader - jwt\nbody - name description color\n201\n400 401 403 404 409 5xx\n\nGET /projects/{project_uuid}/roles\nheader - jwt\n200 - list [role_id name description color]\n401 403 404 5xx\n\nPUT /projects/{project_uuid}/roles/{role_id}\nheader - jwt\nbody - name description color\n200\n400 401 403 404 409 5xx\n\nDELETE /projects/{project_uuid}/roles/{role_id}\nheader - jwt\n204\n401 403 404 409 5xx\n\n\n\nGET /permissions?scope=project\nheader - jwt\n200 - list [permissions description]\n401 5xx\n\nPUT /projects/{project_uuid}/members/{account_uuid}/permissions\nheader - jwt\nbody - list [permission]\n204\n400 401 403 404 409 5xx\n\n\n--------------------------------------------------\n\n\nGET /projects/{project_uuid}/members\nheader - jwt\n200 - list [account_uuid role_id role_name]\n401 403 404 5xx",
